msgstr "RM520N-GL 已通过安全探测。"
msgid "Rotate credentials"
msgstr "轮换凭据"
msgid "SIP account"
msgstr "SIP 账户"
msgid "SIP account is not configured. Registration is not reported by v1 status."
msgstr "SIP 账户尚未配置。v1 状态不报告注册状态。"
msgid "SIP credential rotation is not ready in this backend."
msgstr "当前后端尚未支持 SIP 凭据轮换。"
msgid "Send DTMF %s"
msgstr "发送 DTMF %s"
