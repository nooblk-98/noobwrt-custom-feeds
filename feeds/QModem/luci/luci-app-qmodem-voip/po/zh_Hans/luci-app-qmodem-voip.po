msgstr "调制解调器已接受目标。"
msgid "Disabled"
msgstr "已禁用"
msgid "Early media"
msgstr "早期媒体"
msgid "Enable the experimental call service first."
msgstr "请先启用实验性通话服务。"
msgid "Enabled"
msgstr "已启用"
msgid "Ending call"
msgstr "正在结束通话"
msgid "EXPERIMENTAL"
