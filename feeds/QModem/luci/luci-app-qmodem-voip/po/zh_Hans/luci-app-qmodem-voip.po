msgstr "没有活动通话。"
msgid "No microphone permission has been requested."
msgstr "尚未请求麦克风权限。"
msgid "Outgoing"
msgstr "呼出"
msgid "Password"
msgstr "密码"
msgid "Ready"
msgstr "就绪"
msgid "Recovering"
msgstr "恢复中"
msgid "Reject"
msgstr "拒接"
