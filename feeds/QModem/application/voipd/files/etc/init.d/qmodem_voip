#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

qmodem_voip_recover_startup()
{
	remaining=30
	while [ "$remaining" -gt 0 ]; do
		if /usr/sbin/qmodem_voip_modem_safety recover; then
			return 0
		fi
		remaining=$((remaining - 1))
		[ "$remaining" -gt 0 ] || break
		sleep 1
	done
	logger -t qmodem_voip 'modem recovery failed after bounded startup retries; voice remains unavailable'
	return 1
}

qmodem_voip_interface_address()
{
	interface=$(uci -q get qmodem_voip.sip.interface)
	interface=${interface:-br-lan}
	case $interface in ''|*[!A-Za-z0-9_.:-]*) return 1 ;; esac
	status=$(ubus -t 2 call "network.interface.$interface" status 2>/dev/null) || status=
	device=$(printf '%s\n' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)
	device=${device:-$interface}
	ip -4 -o addr show dev "$device" scope global 2>/dev/null |
		awk 'NR == 1 { sub(/\/.*/, "", $4); print $4 }'
}

qmodem_voip_start_registrar()
{
	lan_address=$1
	[ "$(uci -q get qmodem_voip.sip.enabled)" = 1 ] || return 0
	[ -r /etc/qmodem_voip/sip.conf ] || return 0
	procd_open_instance registrar
	procd_set_param command /usr/sbin/qmodem_voip_registrar_wait --listen-address 0.0.0.0 --advertise-address "$lan_address"
	procd_set_param respawn 3600 5 5
	procd_close_instance
	ubus call service event '{"type":"firewall","data":{"reload":true}}' >/dev/null 2>&1 || :
}

start_service()
{
	qmodem_voip_recover_startup
	mkdir -p -m 700 /etc/qmodem_voip
	lan_address=$(qmodem_voip_interface_address)
	certificate=$(uci -q get uhttpd.main.cert)
	key=$(uci -q get uhttpd.main.key)
	[ -n "$lan_address" ] || return 0
	[ -r "$certificate" ] || return 0
	[ -r "$key" ] || return 0
	procd_open_instance
	procd_set_param command /usr/bin/qmodem_voip --media-address "$lan_address" --media-cert "$certificate" --media-key "$key"
	procd_set_param respawn 3600 5 5
	procd_close_instance

	qmodem_voip_start_registrar "$lan_address"
}

reload_service()
{
	lan_address=$(qmodem_voip_interface_address)
	[ -n "$lan_address" ] || return 0
	qmodem_voip_start_registrar "$lan_address"
}
